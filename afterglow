#!/usr/bin/env python3
"""`afterglow` CLI: proof-first RTL debug loop + dev-happiness helpers.

Usage:
  afterglow run --spec sim/targets/<id>.yaml [--triage|--stop-before-patch]
      [--seed N] [--run-id ID] [--prompt v3|agent/prompts/vX.txt]
      [--rtl path/in/tree] [--goals fix|fix+opt]
      (on a TTY this dispatches to the Rust TUI by default when
      tui-rs/target/release/tui exists; AFTERGLOW_NO_TUI=1 forces the
      pure-Python loop)
  afterglow run --explain runs/<id>   (alias for `afterglow explain`)
  afterglow explain runs/<id>         (human story of a finished bundle)
  afterglow init [--force] [--here]      (checks + example spec scaffold,
                                      or draft one from ./.v/.sv)
  afterglow doctor                       (checklist: python, verilator,
                                      key, pins, trees, suite smoke)
  afterglow demo                         (zero-decision triage of the
                                      fastest locked GREEN case, ~$0.05)
  afterglow --version

The CLI loads (validates) the Task-1 CaseSpec from the --spec path
first -- a missing file, a YAML missing required keys, or a blank
oracle_pass fails fast with exit 1 (no model call, no bundle; blank
markers match every log, so they are refused, mirroring
afterglow_core.policy.check_diff's fail-closed gate) -- then dispatches
to agent/loop.py, which drives RED -> COLLECT -> DIAGNOSE -> EXPLAIN ->
PATCH -> RESIM -> VERIFY. Default is FULL-AUTO (diagnose -> patch ->
resim -> verify end-to-end, exit 0 GREEN / 2 degraded-to-triage /
1 RED); --triage (or --stop-before-patch) selects the old
stop-before-PATCH behavior (diagnosis saved, patch withheld, exit 2).
--auto is accepted for compatibility and also means auto. Any loud
pre-patch failure in auto mode (API flake with no patch, guard
reject with no patch ever applied, --triage withhold) degrades to
a triage-style stop (exit 2, TRIAGE row), never a silent proceed;
a patch applied but resim still RED stays RED (exit 1).

--spec is in-tree-only: the path's stem must match
sim/targets/<id>.yaml, because the loop's RED phase dispatches
sim/sim.py --case <stem>. Unknown stems are rejected by the loop before
any sim/model work.

`afterglow explain runs/<id>` renders a FINISHED bundle as a human
story (RED symptom -> verbatim diagnosis -> patch -> VERIFY checksums
-> cost) from bundle files only -- missing files render as honest
MISSING, never guessed. `afterglow run --explain runs/<id>` is the
same renderer under the run subcommand.

`afterglow init` checks the three things a first run needs (verilator
on PATH, model key in env or .env, foundation.pin + targets.pin
readable) with FAIL lines naming the exact fix, and scaffolds
sim/targets/my-first-case.yaml from an in-tree example template
(never overwrites without --force).
"""
from __future__ import annotations

import argparse
import os
import sys

__version__ = "0.2.0"

ROOT = os.path.dirname(os.path.abspath(__file__))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

#: Absolute path of the release TUI binary. When it exists (and stdout
#: is a TTY, --emit-events was not passed, AFTERGLOW_NO_TUI is
#: unset/empty), `afterglow run` execs it by default.
TUI_BIN = os.path.join(ROOT, "tui-rs", "target", "release", "tui")

from afterglow_core.verilator import load_spec  # noqa: E402
from agent import loop  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="afterglow",
        description="Afterglow proof-first RTL debug loop "
                    "(run | explain | init | watch | doctor | demo).")
    ap.add_argument("--version", action="version",
                    version="afterglow %s" % __version__)
    sub = ap.add_subparsers(dest="command", required=True)
    run = sub.add_parser(
        "run", help="run one --spec case through the agent loop, "
                    "or render a bundle with --explain runs/<id> "
                    "(on a TTY dispatches to the Rust TUI by default; "
                    "AFTERGLOW_NO_TUI=1 forces the pure-Python loop)")
    run.add_argument("spec_pos", nargs="?", default=None,
                     metavar="SPEC",
                     help="positional spec path "
                          "(preferred; e.g. sim/targets/uart-start-half.yaml)")
    run.add_argument("--spec", default=None,
                     help="spec YAML path (deprecated alias for the "
                          "positional SPEC; both resolve identically)")
    run.add_argument("--explain", default=None, metavar="RUN_DIR",
                     help="render a finished bundle as a human story "
                          "(alias for `afterglow explain RUN_DIR`); "
                          "no sim or model calls, missing files "
                          "render as MISSING")
    run.add_argument("--seed", type=int, default=42)
    run.add_argument("--run-id", default=None)
    run.add_argument("--prompt", default=None,
                     help="prompt template (default: agent/prompts/v2.txt; "
                          "pass v3 for the harvest pack)")
    run.add_argument("--rtl", default=None,
                     help="override RTL file under repair (tree-relative)")
    run.add_argument("--auto", action="store_true", default=False,
                     help="attempt PATCH->RESIM->VERIFY (this is the "
                          "default; flag kept for compatibility)")
    run.add_argument("--triage", action="store_true", default=False,
                     help="stop after DIAGNOSE+EXPLAIN with the diagnosis "
                          "saved and the patch withheld (exit 2)")
    run.add_argument("--stop-before-patch", dest="stop_before_patch",
                     action="store_true", default=False,
                     help="alias for --triage: stop before PATCH (exit 2)")
    run.add_argument("--goals", default=None, choices=("fix", "fix+opt"),
                     help="fix (default): fix-first flow only; fix+opt: "
                          "after a GREEN fix, run ONE optimize pass that "
                          "must reduce SIMULATED CYCLES with IDENTICAL "
                          "checksum/tohost (rejected opt never ungreens)")
    run.add_argument("--waveform", action="store_true", default=False,
                     help="attach fail-window waveform PNG to diagnosis "
                          "(uart-TB cases only; others degrade loudly)")
    run.add_argument("--debug", action="store_true", default=False,
                     help="re-raise unexpected errors with a full traceback "
                          "(default: one clean `afterglow: error:` line on "
                          "stderr, exit != 0)")
    run.add_argument("--quiet", action="store_true", default=False,
                     help="suppress the stderr progress display (stdout is "
                          "never touched by progress output)")
    run.add_argument("--verbose", action="store_true", default=False,
                     help="restore the full stage-line output ([RED]/"
                          "[COLLECT]/[DIAGNOSE]/[PATCH]/[RESIM]/[VERIFY] "
                          "and sim echo lines). Default (quiet) prints "
                          "only the progress bar line + the final verdict "
                          "line; --verbose restores today's full output "
                          "byte-for-byte)")
    run.add_argument("--emit-events", default=None, choices=("jsonl",),
                     help="also emit machine-readable loop events as "
                          "single-line JSON objects on stdout (progress, "
                          "attempt boundaries, final verdict). Default "
                          "(flag absent) keeps stdout byte-identical.")
    exp = sub.add_parser(
        "explain", help="render a finished bundle as a human story: "
                         "RED symptom -> diagnosis -> patch -> VERIFY -> cost")
    exp.add_argument("run_dir", metavar="runs/<id>",
                     help="finished bundle dir, e.g. runs/ablate-v2-uartdiv")
    ini = sub.add_parser(
        "init", help="check verilator + model key + pins, scaffold "
                      "an example sim/targets/ spec",
        description="Check the three things a first run needs "
                    "(verilator on PATH, MODEL_API_KEY in env or .env, "
                    "foundation.pin + targets.pin readable) with FAIL "
                    "lines naming the exact fix, then scaffold "
                    "sim/targets/my-first-case.yaml from a built-in "
                    "example template (never overwrites without --force).")
    ini.add_argument("--force", action="store_true", default=False,
                     help="overwrite sim/targets/my-first-case.yaml "
                          "if it already exists")
    ini.add_argument("--here", action="store_true", default=False,
                     help="non-interactive: draft <cwd-basename>.yaml in "
                          "the CURRENT directory from its .v/.sv files "
                          "(reuses watch draft logic; never overwrites "
                          "without --force; placeholders stay "
                          "WATCH_FILL_ME until edited)")
    doc = sub.add_parser(
        "doctor", help="check everything a first run needs, one "
                        "PASS/FAIL line each (python, verilator "
                        "--version, key presence, pins, trees, "
                        "suite smoke); exit 0 all-pass, exit 1 with "
                        "each miss + its one-command fix "
                        "(on a TTY shows the inline checklist; "
                        "AFTERGLOW_NO_TUI=1 forces plain text)",
        description="Checklist for a first run: python version, "
                    "Verilator present (`verilator --version`), model "
                    "key present (presence only, value never printed), "
                    "pins readable, pinned trees cached, suite smoke "
                    "(skipped as slow, command reported). Exit 0 when "
                    "no FAIL line; exit 1 otherwise, each FAIL naming "
                    "the one command that fixes it.")
    dem = sub.add_parser(
        "demo", help="zero-decision triage of the fastest locked GREEN "
                      "case (~$0.05: one diagnosis call, patch withheld)",
        description="Zero-decision end-to-end: triage-only run of the "
                    "fastest locked GREEN case in eval/results.md "
                    "(~$0.05: triage DOES call the model once for the "
                    "diagnosis; patch withheld). No key: fails loud "
                    "with the exact fix command, no fake run.")
    wat = sub.add_parser(
        "watch", help="run a sim command, draft sim/targets/<name>.yaml "
                      "from its log, confirm, then chain into triage",
        description="Run the user's sim command after --, capture exit "
                    "code + full log + argv, draft a CaseSpec (RTL files "
                    "from .v/.sv args, oracle markers from the strongest "
                    "FAIL-like lines with an exit-code fallback), print "
                    "it for confirm (--yes skips), write "
                    "sim/targets/<name>.yaml, then chain into the triage "
                    "path (heuristic draft + user confirm; no model "
                    "calls here). Options must precede --.")
    wat.add_argument("--name", default=None,
                     help="spec stem for sim/targets/<name>.yaml "
                          "(default: sanitized argv[0] basename)")
    wat.add_argument("--project", default="picorv32",
                     help="pinned project for the chained triage run "
                          "(must be in targets.pin)")
    wat.add_argument("--seed", type=int, default=42)
    wat.add_argument("--timeout", type=int, default=600,
                     help="sim command timeout in seconds")
    wat.add_argument("--yes", action="store_true", default=False,
                     help="skip the confirm prompt (print draft, write, "
                          "chain)")
    wat.add_argument("--force", action="store_true", default=False,
                     help="overwrite an existing sim/targets/<name>.yaml")
    wat.add_argument("cmd", nargs=argparse.REMAINDER,
                     help="sim command after --, e.g. -- ./obj_dir/Vtb "
                          "+seed=1")
    return ap


def cmd_explain(run_dir: str) -> int:
    from agent import explain as explain_mod
    target = os.path.join(ROOT, run_dir) \
        if not os.path.isabs(run_dir) and not os.path.exists(run_dir) \
        else run_dir
    if not os.path.isdir(target):
        print("FATAL: bundle dir not found: %s "
              "(expected a finished runs/<id>/ dir; MISSING, not guessed)"
              % run_dir, file=sys.stderr)
        return 1
    print(explain_mod.render(target))
    return 0


def cmd_init(force: bool = False, here: bool = False) -> int:
    if here:
        from agent import doctor as doctor_mod
        from agent import watch as watch_mod
        print("afterglow init --here: drafting a starter CaseSpec from "
              "this directory's .v/.sv files (non-interactive)")
        try:
            dest = doctor_mod.draft_here_spec(os.getcwd(), force=force)
        except watch_mod.WatchError as exc:
            print("FATAL: %s" % (exc,), file=sys.stderr)
            return 1
        print("starter spec: %s (top/tb/anchor/bug are WATCH_FILL_ME "
              "placeholders -- edit before trusting)" % dest)
        print("next: fill the placeholders, then copy it under "
              "sim/targets/ and run `afterglow run --spec "
              "sim/targets/<name>.yaml --triage`")
        return 0
    from afterglow_core import initenv
    print("afterglow init: checking this machine for a first run")
    results = []
    results.append(initenv.check_verilator())
    dotenv = initenv.read_dotenv(ROOT)
    results.append(initenv.check_api_key(dict(os.environ), dotenv))
    results.extend(initenv.check_pins(ROOT))
    rc = 0
    for res in results:
        print(res["message"])
        if res["status"] != "ok":
            rc = 1
    dest = initenv.scaffold_example(ROOT, force=force)
    print("example spec: %s (from built-in template%s)" % (
        os.path.relpath(dest, ROOT)
        if dest.startswith(ROOT) else dest,
        ", overwritten with --force" if force else ""))
    print("next: afterglow run --spec %s"
          % (os.path.relpath(dest, ROOT)
             if dest.startswith(ROOT) else dest))
    if rc != 0:
        print("init: FAIL -- fix the FAIL line(s) above, then re-run "
              "`afterglow init` (no traceback: each line names the fix).")
    else:
        print("init: ok -- this machine can attempt a first run.")
    return rc


def cmd_doctor() -> int:
    from agent import doctor as doctor_mod
    print("afterglow doctor: checking this machine for a first run "
          "(key presence only -- values never printed)")
    results, rc = doctor_mod.run_doctor(ROOT)
    for res in results:
        print(doctor_mod.format_line(res))
    if rc != 0:
        print("doctor: FAIL -- one command per miss:")
        for res in results:
            if res["status"] == "FAIL" and res.get("fix"):
                print("  fix (%s): %s" % (res["name"], res["fix"]))
        print("fix the line(s) above, then re-run `afterglow doctor`.")
    else:
        print("doctor: ok -- this machine can attempt a first run "
              "(try `afterglow demo` for a zero-decision triage).")
    return rc


def demo_tui_argv(*, root, tui_bin, seed=42):
    """TUI argv for the out-of-box demo: fastest locked case + --triage.

    Pure helper (no exec): returns [tui_bin, spec, --seed, --triage].
    Raises whatever pick_demo_case raises when results.md is missing
    or unparsable -- callers fall back to cmd_demo(), which fails
    loud with the exact fix (never a fake run).
    """
    from agent import doctor as doctor_mod
    case = doctor_mod.pick_demo_case(os.path.join(root, "eval", "results.md"))
    spec = os.path.join(root, "sim", "targets", case + ".yaml")
    return [tui_bin, spec, "--seed", str(seed), "--triage"]


def cmd_demo() -> int:
    from agent import doctor as doctor_mod
    return doctor_mod.run_demo(ROOT)


def should_use_tui(*, is_tty: bool, emit_events,
                   no_tui_env: str | None, tui_bin_exists: bool) -> bool:
    """True ONLY when ALL hold: stdout is a TTY, --emit-events was NOT
    passed, AFTERGLOW_NO_TUI is unset/empty, and the release TUI binary
    exists at tui-rs/target/release/tui.

    Missing binary -> False: the pure-Python loop runs instead (CI-safe,
    no error). The --emit-events check alone breaks the TUI exec cycle:
    the TUI always spawns its backend with --emit-events jsonl, so the
    backend never re-execs the TUI.
    """
    return bool(is_tty
                and not emit_events
                and not no_tui_env
                and tui_bin_exists)


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    if args.command == "explain":
        return cmd_explain(args.run_dir)
    if args.command == "init":
        return cmd_init(force=args.force, here=args.here)
    if args.command == "doctor":
        # TTY default: the minimal inline checklist (same should_use_tui
        # path as `run`: TTY + release binary present + AFTERGLOW_NO_TUI
        # unset/empty; doctor has no --emit-events flag so its guard is
        # the env escape, which the TUI backend sets for itself).
        # Non-TTY keeps today's plain-text output byte-identical.
        if should_use_tui(
            is_tty=sys.stdout.isatty(),
            emit_events=None,
            no_tui_env=os.environ.get("AFTERGLOW_NO_TUI"),
            tui_bin_exists=os.path.isfile(TUI_BIN),
        ):
            os.execv(TUI_BIN, [TUI_BIN, "doctor"])
        return cmd_doctor()
    if args.command == "demo":
        # TTY default: same TUI contract as run/doctor (TTY + release
        # binary present + AFTERGLOW_NO_TUI unset/empty; demo has no
        # --emit-events flag so its guard is the env escape). The key
        # gate + cost notice live in cmd_demo(): gate here first so a
        # keyless TTY falls through to the loud fix instead of execing
        # a TUI whose backend would fail. Any resolution failure also
        # falls through -- cmd_demo() fails loud, never a fake run.
        if should_use_tui(
            is_tty=sys.stdout.isatty(),
            emit_events=None,
            no_tui_env=os.environ.get("AFTERGLOW_NO_TUI"),
            tui_bin_exists=os.path.isfile(TUI_BIN),
        ):
            try:
                from agent import doctor as doctor_mod
                if doctor_mod.check_api_key(
                        env=dict(os.environ), dotenv={})["status"] == "PASS":
                    print(
                        "afterglow demo: triage-only run of the fastest "
                        "locked case -- this burns ONE model diagnosis "
                        "call (%s); patch withheld, diagnosis saved"
                        % doctor_mod.DEMO_COST_NOTE, flush=True)
                    os.execv(TUI_BIN, demo_tui_argv(
                        root=ROOT, tui_bin=TUI_BIN))
            except Exception:
                pass
        return cmd_demo()
    if args.command == "watch":
        from agent import watch as watch_mod
        fwd = []
        if args.name:
            fwd += ["--name", args.name]
        fwd += ["--project", args.project, "--seed", str(args.seed),
                "--timeout", str(args.timeout)]
        if args.yes:
            fwd.append("--yes")
        if args.force:
            fwd.append("--force")
        # args.cmd may already start with the `--` separator (REMAINDER
        # keeps it); watch.main strips leading `--` itself, so forward
        # verbatim -- never prepend another one.
        fwd += list(args.cmd or [])
        return watch_mod.main(fwd)
    if args.command == "run":
        if args.explain:
            return cmd_explain(args.explain)
        spec_path = resolve_run_spec(args)
        if not spec_path:
            print("FATAL: need SPEC sim/targets/<id>.yaml "
                  "(or --explain runs/<id> to render a bundle; "
                  "--spec is a deprecated alias for SPEC)",
                  file=sys.stderr)
            return 2
        # Recursion guard: the TUI always spawns its backend as
        # `afterglow run <spec> --emit-events jsonl ...` (see
        # tui-rs/src/main.rs), so the --emit-events check inside
        # should_use_tui() alone breaks the exec cycle: TUI ->
        # backend-with---emit-events -> pure-Python loop, never back
        # to the TUI.
        if should_use_tui(
            is_tty=sys.stdout.isatty(),
            emit_events=args.emit_events,
            no_tui_env=os.environ.get("AFTERGLOW_NO_TUI"),
            tui_bin_exists=os.path.isfile(TUI_BIN),
        ):
            tui_argv = [TUI_BIN, spec_path, "--seed", str(args.seed)]
            if args.run_id:
                tui_argv += ["--run-id", args.run_id]
            if args.prompt:
                tui_argv += ["--prompt", args.prompt]
            if args.rtl:
                tui_argv += ["--rtl", args.rtl]
            if args.auto:
                tui_argv.append("--auto")
            if args.triage:
                tui_argv.append("--triage")
            if args.stop_before_patch:
                tui_argv.append("--stop-before-patch")
            if args.goals:
                tui_argv += ["--goals", args.goals]
            if args.waveform:
                tui_argv.append("--waveform")
            if args.debug:
                tui_argv.append("--debug")
            if args.verbose:
                tui_argv.append("--verbose")
            if args.quiet:
                tui_argv.append("--quiet")
            # --emit-events is deliberately NOT forwarded: the TUI adds
            # it for its backend itself.
            os.execv(TUI_BIN, tui_argv)
        try:
            spec = load_spec(spec_path)
        except (OSError, ValueError, KeyError) as exc:
            print("FATAL: cannot load spec %r: %s" % (spec_path, exc),
                  file=sys.stderr)
            return 1
        loop_argv = ["--spec", spec_path, "--seed", str(args.seed)]
        if args.auto:
            loop_argv.append("--auto")
        if args.triage:
            loop_argv.append("--triage")
        if args.stop_before_patch:
            loop_argv.append("--stop-before-patch")
        if args.goals:
            loop_argv += ["--goals", args.goals]
        if args.waveform:
            loop_argv.append("--waveform")
        if args.debug:
            loop_argv.append("--debug")
        if args.quiet:
            loop_argv.append("--quiet")
        if args.verbose:
            loop_argv.append("--verbose")
        if args.emit_events:
            loop_argv += ["--emit-events", args.emit_events]
        if args.run_id:
            loop_argv += ["--run-id", args.run_id]
        if args.prompt:
            loop_argv += ["--prompt", args.prompt]
        if args.rtl:
            loop_argv += ["--rtl", args.rtl]
        if args.verbose:
            print("afterglow run: spec %s (case %s)"
                  % (spec_path, spec.case_id), flush=True)
        try:
            return loop.main(loop_argv)
        except SystemExit:
            raise
        except Exception as exc:  # noqa: BLE001 -- clean-error wrapper
            if args.debug:
                raise
            print("afterglow: error: %s (use --debug for traceback)" % (exc,),
                  file=sys.stderr)
            return 1
    build_parser().print_help()
    return 2


def resolve_run_spec(args) -> str | None:
    """Spec path for `afterglow run`: positional SPEC wins, --spec stays.

    `--spec` is a deprecated alias: both forms resolve to the same path
    (when both are given the positional one wins and --spec is ignored).
    """
    return getattr(args, "spec_pos", None) or getattr(args, "spec", None)


if __name__ == "__main__":
    sys.exit(main())
